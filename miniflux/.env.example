# Copied to miniflux/.env by scripts/setup-miniflux-host.sh, which fills in fresh
# secrets. Mirror the admin credentials into ~/.hermes/.env as MINIFLUX_USERNAME /
# MINIFLUX_PASSWORD so Ella's feeds adapter can reach the API.
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=
MINIFLUX_ADMIN_USERNAME=ella
MINIFLUX_ADMIN_PASSWORD=
