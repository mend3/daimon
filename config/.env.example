# Hermes Agent secrets / env overrides.
# Copied to ~/.hermes/.env on first container create (only if missing).
# config.yaml takes precedence over these for model settings; they are kept as a
# belt-and-suspenders for env-driven code paths.

# --- Local Ollama (OpenAI-compatible) ---------------------------------------
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama

# --- Web search --------------------------------------------------------------
# Local SearXNG started by scripts/setup-searxng-host.sh.
SEARXNG_URL=http://host.docker.internal:8888

# Alternatives (set web.backend in config.yaml to match):
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# --- Telegram messaging gateway ---------------------------------------------
# Token from @BotFather. Real value lives only in ~/.hermes/.env (never commit).
# TELEGRAM_BOT_TOKEN=

# --- Optional: forwarded into Docker tool sandboxes -------------------------
# GITHUB_TOKEN=
