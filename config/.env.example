# Hermes Agent secrets / env overrides.
# Copied to ~/.hermes/.env on the first container start (only if missing).
# config.yaml takes precedence over these for model settings; they are kept as a
# belt-and-suspenders for env-driven code paths.

# --- OpenAI (fallback model: gpt-5-mini) ----------------------------------------
# OPTIONAL. The default profile runs the local gpt-oss:20b and falls back to OpenAI
# only when it errors out; with no key, Daimon runs local-only. Put your OpenAI API
# key here (or in the repo's own .env, which compose passes through) and setup.sh
# writes it and the api.openai.com endpoint into ~/.hermes/.env (OPENAI_API_KEY /
# OPENAI_BASE_URL) for the openai-api provider.
OPENAI_PROFILE_API_KEY=

# Managed by setup.sh (overridden from OPENAI_PROFILE_API_KEY when set). Seeded to
# the shared Ollama so OpenAI-compatible code paths have a value when no key is given.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama

# --- Web search --------------------------------------------------------------
# Daimon's own SearXNG sidecar on the shared network (`make searxng`).
SEARXNG_URL=http://searxng:8080

# --- Knowledge base (Qdrant) -------------------------------------------------
# Vector store provided by your shared stack (DNS `qdrant:6333`). Set QDRANT_API_KEY to
# match its config if it requires one.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Knowledge base connectors (optional, off by default) --------------------
# Feeds: needs a Miniflux of your own — point this at it.
# MINIFLUX_URL=
# MINIFLUX_USERNAME=
# MINIFLUX_PASSWORD=
# Webhook receiver: shared secret for HMAC-signed pushes (`daimon-kb webhook-serve`).
# KB_WEBHOOK_SECRET=
# KB_WEBHOOK_BIND=127.0.0.1:8771

# Alternatives (set web.backend in config.yaml to match):
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# --- Telegram messaging gateway ---------------------------------------------
# Token from @BotFather. Real value lives only in ~/.hermes/.env (never commit).
# The gateway refuses to start with a token but no allowlist — it exposes an
# agent with shell/file tools. `hermes gateway setup` pairs your account and
# fills TELEGRAM_ALLOWED_USERS for you.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=        # comma-separated Telegram user IDs

# --- Persona source (the hub) ------------------------------------------------
# Daimon's persona lives in the hub (GET /api/internal/persona) and setup.sh writes
# it into the SOUL.md Hermes reads; the repo's config/SOUL.md is only the offline
# fallback. Point the URL at the hub on the shared network and use its
# HUB_WORKER_TOKEN — the same shared secret the hub's other internal routes take.
# HUB_INTERNAL_URL=http://hub-web:3000
# HUB_WORKER_TOKEN=

# --- Optional: forwarded into Docker tool sandboxes -------------------------
# GITHUB_TOKEN=
