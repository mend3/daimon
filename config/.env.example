# Hermes Agent secrets / env overrides.
# Copied to ~/.hermes/.env on first container create (only if missing).
# config.yaml takes precedence over these for model settings; they are kept as a
# belt-and-suspenders for env-driven code paths.

# --- Local Ollama (OpenAI-compatible) ---------------------------------------
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama

# --- OpenAI task profile -----------------------------------------------------
# The `openai` profile (kanban task agents) runs on the real OpenAI API. Its model
# config references this key; postCreate propagates it into the profile's isolated
# .env. Kept distinct from OPENAI_API_KEY above, which points the default profile at
# the local Ollama. Leave blank to keep tasks on the local profile.
OPENAI_PROFILE_API_KEY=

# --- Web search --------------------------------------------------------------
# Local SearXNG started by scripts/setup-searxng-host.sh.
SEARXNG_URL=http://host.docker.internal:8888

# --- Knowledge base (Qdrant) -------------------------------------------------
# Vector store started by scripts/setup-qdrant-host.sh. Copy the key it generates
# (printed by the script, stored in qdrant/.env) into the line below.
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=

# --- Knowledge base connectors (optional, off by default) --------------------
# Feeds: Miniflux, started by scripts/setup-miniflux-host.sh (it prints these).
# MINIFLUX_URL=http://host.docker.internal:8930
# MINIFLUX_USERNAME=
# MINIFLUX_PASSWORD=
# Webhook receiver: shared secret for HMAC-signed pushes (`ella-kb webhook-serve`).
# KB_WEBHOOK_SECRET=
# KB_WEBHOOK_BIND=127.0.0.1:8771

# Alternatives (set web.backend in config.yaml to match):
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# --- Telegram messaging gateway ---------------------------------------------
# Token from @BotFather. Real value lives only in ~/.hermes/.env (never commit).
# The gateway refuses to start with a token but no allowlist — it exposes an
# agent with shell/file tools. `hermes gateway setup` pairs your account and
# fills TELEGRAM_ALLOWED_USERS for you.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=        # comma-separated Telegram user IDs

# --- Optional: forwarded into Docker tool sandboxes -------------------------
# GITHUB_TOKEN=
