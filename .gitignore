# --- Project ---------------------------------------------------------------
# Local secrets — never commit. Use config/.env.example as the template.
config/.env
.env
.env.*
!.env.example

# Hermes runtime data (lives in the named Docker volume, not the repo)
.hermes/

# SearXNG local config (generated from the example, holds a secret_key)
docker/searxng/settings.yml

# Ephemeral session context and Claude Code runtime artifacts
.claude/SESSION.md
.claude/*.lock
.claude/settings.local.json

