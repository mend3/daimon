{
  // Editing environment for this repo — a dev shell that is the same on any host OS.
  // It reuses the runtime's image and setup script verbatim (`docker/agent/`), so
  // what you develop against is what compose runs.
  //
  // Running Hermes is compose's job (`make up` → service `agent`), not this
  // container's: both mount the same hermes-data volume, and two gateways sharing one
  // state.db is one too many. So no gateway starts here — edit in this container,
  // talk to him with `docker compose exec agent hermes`.
  "name": "daimon-dev",
  "build": {
    "dockerfile": "../docker/agent/Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",

  // Join the shared Docker network: that is where the infra Daimon consumes lives
  // (ollama, qdrant, redis) alongside his own sidecars (daimon-searxng, daimon-tts),
  // all reached by DNS. Your shared infra stack owns that network, so start it first or
  // this container has nothing to attach to. Set SHARED_NETWORK in the environment to
  // match your stack's network name (`make devcontainer` passes it through).
  // host.docker.internal stays resolvable for anything published on the host instead.
  "runArgs": [
    "--network=${localEnv:SHARED_NETWORK:shared}",
    "--add-host=host.docker.internal:host-gateway"
  ],

  // The same two volumes the compose service mounts — same agent, same memories,
  // whichever way it is brought up. ~/.hermes holds config/memories/sessions/agent
  // code; ~/.local holds the uv-managed Python runtime and launcher the venv links
  // to — without it, every rebuild reinstalls Hermes from scratch.
  "mounts": [
    "source=hermes-data,target=/home/vscode/.hermes,type=volume",
    "source=hermes-local,target=/home/vscode/.local,type=volume"
  ],

  // The image's entrypoint starts the gateway; this container is for editing, so let
  // the devcontainer's own idle command run instead.
  "overrideCommand": true,

  // Point Hermes' OpenAI-compatible client at the shared Ollama. These are also set
  // explicitly in config.yaml; kept here so any env-driven code path agrees.
  "containerEnv": {
    "OPENAI_BASE_URL": "http://ollama:11434/v1",
    "OPENAI_API_KEY": "ollama",
    "OLLAMA_BASE_URL": "http://ollama:11434"
  },

  // The same script the runtime container runs on every start: installs Hermes into
  // the volumes when absent, then syncs config from the repo.
  "postCreateCommand": "bash docker/agent/setup.sh",

  "customizations": {
    "vscode": {
      // Disable the JS debugger auto-attach: it injects NODE_OPTIONS (a --require
      // bootloader) into terminals, which breaks node/npm — and the dashboard's
      // frontend build — when the path is stale. Off means `hermes dashboard` works.
      "settings": {
        "debug.javascript.autoAttachFilter": "disabled"
      },
      "extensions": [
        "redhat.vscode-yaml",
        "anthropic.claude-code",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
