{
  "name": "hermes-agent-local",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  // host.docker.internal lets the container reach Ollama running natively on the
  // macOS host (Metal-accelerated). host-gateway makes the alias resolve on Linux
  // Docker too, and is a harmless no-op on Docker Desktop for Mac.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  // Persist Hermes data and the installed toolchain across rebuilds via named
  // volumes. ~/.hermes holds config/memories/sessions/agent code; ~/.local holds
  // the uv-managed Python runtime and launcher the venv links to — without it,
  // every rebuild reinstalls Hermes from scratch.
  "mounts": [
    "source=hermes-data,target=/home/vscode/.hermes,type=volume",
    "source=hermes-local,target=/home/vscode/.local,type=volume"
  ],

  // The container's own CMD (container-boot.sh) keeps it alive and starts the
  // gateway under PID 1, so we let the image command run instead of the default.
  "overrideCommand": false,

  // Point Hermes' OpenAI-compatible client at the host Ollama endpoint. These are
  // also set explicitly in config.yaml; kept here so any env-driven code path agrees.
  "containerEnv": {
    "OPENAI_BASE_URL": "http://host.docker.internal:11434/v1",
    "OPENAI_API_KEY": "ollama",
    "OLLAMA_BASE_URL": "http://host.docker.internal:11434"
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml"
      ]
    }
  }
}
