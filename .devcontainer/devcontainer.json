{
  "name": "hermes-agent-local",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  // Node + npm for building the Hermes web dashboard frontend (built on first
  // `hermes dashboard` launch). The Hermes installer's bundled Node is not on PATH.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Join the shared Docker network: that is where the infra Daimon consumes lives
  // (ollama, qdrant, redis) alongside her own sidecars (daimon-searxng, daimon-tts),
  // all reached by DNS. Your shared infra stack owns that network, so start it first or
  // this container has nothing to attach to. Set SHARED_NETWORK in the environment to
  // match your stack's network name (`make devcontainer` passes it through).
  // host.docker.internal stays resolvable for anything published on the host instead.
  "runArgs": [
    "--network=${localEnv:SHARED_NETWORK:shared}",
    "--add-host=host.docker.internal:host-gateway"
  ],

  // Persist Hermes data and the installed toolchain across rebuilds via named
  // volumes. ~/.hermes holds config/memories/sessions/agent code; ~/.local holds
  // the uv-managed Python runtime and launcher the venv links to — without it,
  // every rebuild reinstalls Hermes from scratch.
  "mounts": [
    "source=hermes-data,target=/home/vscode/.hermes,type=volume",
    "source=hermes-local,target=/home/vscode/.local,type=volume"
  ],

  // The container's own CMD (container-boot.sh) keeps it alive and starts the
  // gateway under PID 1, so we let the image command run instead of the default.
  "overrideCommand": false,

  // Point Hermes' OpenAI-compatible client at the shared Ollama. These are also set
  // explicitly in config.yaml; kept here so any env-driven code path agrees.
  "containerEnv": {
    "OPENAI_BASE_URL": "http://ollama:11434/v1",
    "OPENAI_API_KEY": "ollama",
    "OLLAMA_BASE_URL": "http://ollama:11434"
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      // Disable the JS debugger auto-attach: it injects NODE_OPTIONS (a --require
      // bootloader) into terminals, which breaks node/npm — and the dashboard's
      // frontend build — when the path is stale. Off means `hermes dashboard` works.
      "settings": {
        "debug.javascript.autoAttachFilter": "disabled"
      },
      "extensions": [
        "redhat.vscode-yaml",
        "anthropic.claude-code",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
