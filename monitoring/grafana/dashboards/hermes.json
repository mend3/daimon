{
  "uid": "hermes-live",
  "title": "Hermes — Atividade ao vivo",
  "tags": ["hermes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "liveNow": true,
  "time": { "from": "now-3h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Fonte",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(source)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Nível",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({source=\"hermes\"}, level)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "component",
        "label": "Componente",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({source=\"hermes\"}, component)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Busca (regex)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 100, "type": "text", "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": { "mode": "markdown", "content": "### 🛰️ Hermes — atividade ao vivo\nFiltre por **Fonte / Nível / Componente** ou digite uma **regex** em *Busca* (aplica a todos os painéis de log). Fontes: `hermes` (agente+Telegram), `ollama`, `searxng`. Atualiza a cada 10s." }
    },

    {
      "id": 10, "type": "stat", "title": "📨 Msgs Telegram",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "justifyMode": "auto", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({source=\"hermes\"} |= \"inbound message\" [$__range]))", "queryType": "instant" } ]
    },
    {
      "id": 11, "type": "stat", "title": "📤 Respostas",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({source=\"hermes\"} |= \"Sending response\" [$__range]))", "queryType": "instant" } ]
    },
    {
      "id": 12, "type": "stat", "title": "🧠 Reqs Ollama",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({source=\"ollama\"} |~ `POST .*(chat/completions|generate)` [$__range]))", "queryType": "instant" } ]
    },
    {
      "id": 13, "type": "stat", "title": "⏱️ Latência últ.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({source=\"hermes\"} |= \"response ready\" | regexp `time=(?P<t>[0-9.]+)s` | unwrap t [$__range])", "queryType": "instant" } ]
    },
    {
      "id": 14, "type": "stat", "title": "⚠️ Erros",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({source=\"hermes\", level=\"ERROR\"} [$__range]))", "queryType": "instant" } ]
    },
    {
      "id": 15, "type": "stat", "title": "💬 Turnos do agente",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 3 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({source=\"hermes\"} |~ `conversation turn` [$__range]))", "queryType": "instant" } ]
    },

    {
      "id": 20, "type": "timeseries", "title": "Volume de logs do agente por nível",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 14, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal", "group": "A" }, "lineWidth": 0 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "WARNING" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "DEBUG" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (level) (count_over_time({source=\"hermes\", level=~\"${level:regex}\", component=~\"${component:regex}\"} [$__auto]))", "legendFormat": "{{level}}", "queryType": "range" } ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Latência de resposta (s)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 7 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "points", "pointSize": 7, "lineWidth": 1, "fillOpacity": 10, "showPoints": "always" }, "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max_over_time({source=\"hermes\"} |= \"response ready\" | regexp `time=(?P<t>[0-9.]+)s` | unwrap t [$__auto])", "legendFormat": "latência", "queryType": "range" } ]
    },

    {
      "id": 30, "type": "logs", "title": "🛰️ Stream unificado  ·  Fonte=$source  Nível=$level  Busca=\"$search\"",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 14 },
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{source=~\"${source:regex}\", level=~\"${level:regex}\"} |~ `(?i)$search`", "queryType": "range" } ]
    },

    {
      "id": 40, "type": "row", "title": "🔬 Por fonte (expandir)", "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "panels": [
        {
          "id": 41, "type": "logs", "title": "📨 Telegram (entrada / resposta)",
          "datasource": { "type": "loki", "uid": "loki" },
          "gridPos": { "h": 12, "w": 12, "x": 0, "y": 30 },
          "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
          "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{source=\"hermes\"} |~ `inbound message|response ready|Sending response` |~ `(?i)$search`", "queryType": "range" } ]
        },
        {
          "id": 42, "type": "logs", "title": "🧠 Ollama (requisições / carga de modelo)",
          "datasource": { "type": "loki", "uid": "loki" },
          "gridPos": { "h": 12, "w": 12, "x": 12, "y": 30 },
          "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
          "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{source=\"ollama\"} |~ `(?i)$search`", "queryType": "range" } ]
        }
      ]
    }
  ]
}
